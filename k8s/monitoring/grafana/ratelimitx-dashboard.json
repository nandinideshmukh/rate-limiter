{
  "id": null,
  "uid": "ratelimitx-overview",
  "title": "RateLimitX - Distributed Rate Limiter Monitoring",
  "tags": [
    "ratelimitx",
    "rate-limiter"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Allowed Requests / Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(ratelimitx_requests_total{status=\"allowed\"}[1m]))",
          "legendFormat": "allowed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rejected Requests / Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(ratelimitx_rejected_requests_total[1m]))",
          "legendFormat": "rejected",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Requests by Algorithm",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (algorithm) (rate(ratelimitx_requests_total[1m]))",
          "legendFormat": "{{algorithm}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests by Policy Tier",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (tier) (rate(ratelimitx_requests_total[1m]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request Latency - p50",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ratelimitx_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Request Latency - p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ratelimitx_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Request Latency - p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ratelimitx_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Rejection Rate by Algorithm",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (algorithm) (rate(ratelimitx_rejected_requests_total[1m]))",
          "legendFormat": "{{algorithm}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Overall Request Volume",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(ratelimitx_requests_total[1m]))",
          "legendFormat": "all requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Rejection Rate by Algorithm and Tier",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (algorithm, tier) (rate(ratelimitx_rejected_requests_total[1m]))",
          "legendFormat": "{{algorithm}} / {{tier}}",
          "refId": "A"
        }
      ]
    }
  ]
}
